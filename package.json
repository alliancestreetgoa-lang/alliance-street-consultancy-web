{
  "name": "alliance-street-consultancy-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run optimize:images",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prebuild": "node scripts/optimize-images.mjs && npm run validate:content",
    "optimize:images": "node scripts/optimize-images.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "vitest run tests/content.test.ts",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only firestore --project demo-alliance-street \"vitest run tests/firestore-rules.test.ts\"",
    "admin:dev": "vite --config admin/vite.config.ts",
    "admin:build": "tsc -p admin/tsconfig.json && vite build --config admin/vite.config.ts",
    "admin:deploy": "npm run admin:build && npx --yes firebase-tools@15 deploy --only hosting --project alliance-street-leads",
    "test:e2e": "node tests/e2e/build-fixture-site.mjs && playwright test",
    "test:portal": "npx --yes firebase-tools@15 emulators:exec --only auth,firestore --project demo-alliance-street \"playwright test -c playwright.portal.config.ts\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.25.0",
    "next": "^16.3.8",
    "radix-ui": "^1.6.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "remotion": "4.0.532",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "js-yaml": "^5.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
